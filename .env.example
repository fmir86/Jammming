# Copy this file to .env and fill in your own values.
# Client ID of an app created at https://developer.spotify.com/dashboard
REACT_APP_SPOTIFY_CLIENT_ID=
# Must match a Redirect URI registered on that app, exactly.
# Optional: defaults to the address the app is served from, plus "/".
REACT_APP_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/
